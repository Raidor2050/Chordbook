# Chordbook environment configuration.
#
# Copy this file to `.env` for local development, or set these variables in
# your CI / hosting environment. Values here are SAFE public placeholders —
# never put service-role keys in here (or anywhere in the frontend).

# --- Supabase (persistent shared song library) ------------------------------
# The frontend only ever uses the *anon* (public) key + URL. It can read and
# create songs under row-level security; the service-role key is for your
# backend tooling only and must never be embedded in the app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# If these two are left empty the app runs in "local draft" mode and stores
# songs in the browser (IndexedDB). Enable them to activate the shared,
# multi-user library. See docs/backends.md and supabase/schema.sql.